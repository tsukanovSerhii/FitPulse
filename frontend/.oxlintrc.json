{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@/features/*/**", "!@/features/*/model", "!@/features/*/catalog", "@/features/*/model/**"],
            "message": "Import a feature through its public API: @/features/<name>, @/features/<name>/model or @/features/<name>/catalog."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["@/features/**", "@/pages/**", "@/app/**"], "message": "shared must not depend on features, pages or app." }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/*/**", "!@/features/*/model", "!@/features/*/catalog", "@/features/*/model/**"],
                "message": "Import a feature through its public API: @/features/<name>, @/features/<name>/model or @/features/<name>/catalog."
              },
              { "group": ["@/pages/**", "@/app/**", "!@/app/store/hooks"], "message": "Features must not depend on pages or app (typed store hooks excepted)." }
            ]
          }
        ]
      }
    }
  ]
}
