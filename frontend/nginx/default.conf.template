# Rendered by the nginx image at start: ${PORT}, ${API_UPSTREAM} and ${PROXY_SECRET} come from the environment
# TLS ends at Render's edge: keep its scheme, or ours when nginx is reached directly
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  '' $scheme;
}

server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  server_tokens off;

  # The visitor's address is the last X-Forwarded-For entry, the one Render's edge appended;
  # anything before it came from the visitor and is ignored
  set_real_ip_from 0.0.0.0/0;
  set_real_ip_from ::/0;
  real_ip_header X-Forwarded-For;
  real_ip_recursive off;

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml application/manifest+json application/xml;

  # The API lives on this same origin, so the refresh-token cookie stays first-party
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_ssl_server_name on;
    # The API trusts X-Client-IP only together with the shared secret, so the visitor cannot set it
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Client-IP $remote_addr;
    proxy_set_header X-Proxy-Secret "${PROXY_SECRET}";
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    client_max_body_size 5m;
    # A sleeping free API on Render takes about a minute to wake up
    proxy_connect_timeout 90s;
    proxy_read_timeout 120s;
  }

  location = /sw.js {
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "no-cache";
  }

  location /assets/ {
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # The reset link carries a one-time token: keep it out of access logs and referrers
  location = /reset-password {
    access_log off;
    include /etc/nginx/security-headers.conf;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cache-Control "no-store";
    try_files /index.html =404;
  }

  # Prerendered pages first (/exercise/bench-press), then the single-page app
  location / {
    include /etc/nginx/security-headers.conf;
    # HTML is revalidated on every load so a deploy never leaves pages pointing at removed assets
    add_header Cache-Control "no-cache";
    try_files $uri $uri.html $uri/index.html /index.html;
  }
}
