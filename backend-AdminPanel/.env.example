# Used when running the API outside Docker (npm run dev -w @fitpulse/admin-api)
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://fitpulse:fitpulse@localhost:5432/fitpulse
REDIS_URL=redis://localhost:6379
# At least 32 characters; production gets its own value in the Render dashboard
ADMIN_JWT_SECRET=dev-only-admin-jwt-secret-change-me-0000000000
# Comma-separated origins allowed to call the API directly (not needed behind the Vite proxy)
CORS_ORIGIN=
