# Used when running the API outside Docker (npm run dev -w @fitpulse/api)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://fitpulse:fitpulse@localhost:5432/fitpulse
REDIS_URL=redis://localhost:6379
# At least 32 characters; production gets its own value in the Render dashboard
JWT_SECRET=dev-only-jwt-secret-change-me-0000000000
# Comma-separated origins allowed to call the API directly (not needed behind the Vite proxy)
CORS_ORIGIN=
# true makes the container apply Prisma migrations before the server starts
RUN_MIGRATIONS=false
