    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@fitpulse/contracts": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
