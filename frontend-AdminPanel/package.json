{
  "name": "@fitpulse/admin-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @fitpulse/contracts --prefix ..",
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
