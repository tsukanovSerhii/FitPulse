generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// A FitPulse app account
model User {
  id              String               @id @default(uuid()) @db.Uuid
  /// citext: Ann@x.com and ann@x.com are the same account
  email           String               @unique @db.Citext
  passwordHash    String               @map("password_hash")
  name            String
  plan            Plan                 @default(FREE)
  emailVerifiedAt DateTime?            @map("email_verified_at") @db.Timestamptz(3)
  blockedAt       DateTime?            @map("blocked_at") @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions        Session[]
  passwordResets  PasswordResetToken[]
  syncRecords     SyncRecord[]
  activity        UserActivity[]
  exercises       CommunityExercise[]

  @@map("users")
}

/// A signed-in device of an app user; the refresh token is stored only as a hash
model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the current refresh token
  refreshTokenHash  String    @unique @map("refresh_token_hash")
  /// The token it replaced, to tell a parallel tab (grace window) from a stolen token
  previousTokenHash String?   @map("previous_token_hash")
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(3)
  remember          Boolean   @default(false)
  userAgent         String?   @map("user_agent")
  /// mobile, tablet or desktop, from the User-Agent
  deviceType        String?   @map("device_type")
  os                String?
  browser           String?
  /// browser or installed (PWA)
  appMode           String?   @map("app_mode")
  /// ISO country code and city from DB-IP City Lite
  country           String?
  city              String?
  /// 93.75.12.x: never the full address; cleared after 90 days
  ipPrefix          String?   @map("ip_prefix")
  lastSeenAt        DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([createdAt])
  @@index([previousTokenHash])
  @@map("sessions")
}

enum Plan {
  FREE
  PRO

  @@map("plan")
}

/// One-time link to set a new password; only the SHA-256 of the token is stored
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum AdminRole {
  MANAGER
  ADMIN

  @@map("admin_role")
}

/// A staff account of the admin panel, kept apart from app users
model AdminUser {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique @db.Citext
  passwordHash String          @map("password_hash")
  role         AdminRole
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  disabledAt   DateTime?       @map("disabled_at") @db.Timestamptz(3)
  sessions     AdminSession[]
  auditLog     AdminAuditLog[]
  reviews      CommunityExercise[]

  @@map("admin_users")
}

model AdminSession {
  id                String    @id @default(uuid()) @db.Uuid
  adminId           String    @map("admin_id") @db.Uuid
  admin             AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  /// SHA-256 of the current refresh token
  refreshTokenHash  String    @unique @map("refresh_token_hash")
  /// The token it replaced, to tell a parallel tab (grace window) from a stolen token
  previousTokenHash String?   @map("previous_token_hash")
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(3)
  remember          Boolean   @default(false)
  userAgent         String?   @map("user_agent")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([adminId])
  @@index([previousTokenHash])
  @@map("admin_sessions")
}

/// One synced item of an app account (a workout, a program, a setting ...) as the device stores it
model SyncRecord {
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  recordId  String    @map("record_id")
  /// null once the record is deleted
  data      Json?
  updatedAt DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  /// Grows with every change; devices pull everything after the last seq they have
  seq       BigInt    @unique @default(autoincrement())

  @@id([userId, kind, recordId])
  @@index([userId, seq])
  // Admin statistics: workouts by kind and activity in the last days
  @@index([kind, updatedAt])
  @@index([updatedAt])
  @@map("sync_records")
}

/// Every change a staff member makes, written in the same transaction as the change
model AdminAuditLog {
  id        String     @id @default(uuid()) @db.Uuid
  /// null once the staff account is deleted
  adminId   String?    @map("admin_id") @db.Uuid
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action    String
  targetId  String?    @map("target_id")
  details   Json?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([adminId, createdAt])
  @@index([createdAt])
  @@map("admin_audit_log")
}

/// Minutes a user spent in the app with the tab visible, per day
model UserActivity {
  userId  String   @map("user_id") @db.Uuid
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day     DateTime @db.Date
  minutes Int      @default(0)

  @@id([userId, day])
  @@index([day])
  @@map("user_activity")
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("submission_status")
}

/// An exercise a user wrote for others: everyone after moderation, or a trainer's students
model CommunityExercise {
  id           String           @id @default(uuid()) @db.Uuid
  authorId     String           @map("author_id") @db.Uuid
  author       User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// public: the whole catalog after review; students: only the author's students
  audience     String           @default("public")
  status       SubmissionStatus @default(PENDING)
  /// The exercise in the app's shape, validated by communityExerciseSchema
  data         Json
  rejectReason String?          @map("reject_reason")
  reviewedById String?          @map("reviewed_by") @db.Uuid
  reviewedBy   AdminUser?       @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?        @map("reviewed_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([authorId, createdAt])
  @@map("community_exercises")
}
